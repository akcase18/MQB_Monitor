{
  // Tasks for this repo's Python tooling. Run with "Terminal > Run Task…"
  // (or ⇧⌘B for the default build task = Monitor Demo).
  //
  // Monitor tasks (tools/monitor) run from that folder so the mqb_monitor
  // package resolves. Logs tasks (tools/log_export) run from the repo root
  // so a relative CSV path lands somewhere findable — but they borrow the
  // *monitor's* virtualenv, which already has both of what they need
  // (pyserial for dump_log.py, PySide6 as well for the GUI). Run
  // "Monitor: Set up venv" once first.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Monitor: Demo (no hardware)",
      "type": "shell",
      "command": "${workspaceFolder}/tools/monitor/.venv/bin/python",
      "args": ["run.py", "--demo"],
      "options": { "cwd": "${workspaceFolder}/tools/monitor" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Monitor: Connect to Teensy (auto-detect port)",
      "type": "shell",
      "command": "${workspaceFolder}/tools/monitor/.venv/bin/python",
      "args": ["run.py"],
      "options": { "cwd": "${workspaceFolder}/tools/monitor" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Monitor: Connect to Teensy (choose port…)",
      "type": "shell",
      "command": "${workspaceFolder}/tools/monitor/.venv/bin/python",
      "args": ["run.py", "--port", "${input:serialPort}"],
      "options": { "cwd": "${workspaceFolder}/tools/monitor" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Monitor: Selftest (headless)",
      "type": "shell",
      "command": "${workspaceFolder}/tools/monitor/.venv/bin/python",
      "args": ["run.py", "--selftest"],
      "options": { "cwd": "${workspaceFolder}/tools/monitor" },
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Monitor: Set up venv",
      "detail": "Create tools/monitor/.venv and install PySide6 + pyserial",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}/tools/monitor" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Logs: Open Log Export app",
      "detail": "GUI: device status, download, preview, CSV export",
      "type": "shell",
      "command": "${workspaceFolder}/tools/monitor/.venv/bin/python",
      "args": ["tools/log_export/run.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Logs: Open Log Export app (simulator storage)",
      "detail": "Same app, reading sim_storage/ instead of a device — no hardware needed",
      "type": "shell",
      "command": "${workspaceFolder}/tools/monitor/.venv/bin/python",
      "args": ["tools/log_export/run.py", "--folder", "sim_storage"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Logs: Status (is the device recording?)",
      "detail": "LOGSTATUS — ready flag, session, capture count, recorded ms",
      "type": "shell",
      "command": "${workspaceFolder}/tools/monitor/.venv/bin/python",
      "args": ["tools/log_export/dump_log.py", "--status"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Logs: Download to CSV…",
      "detail": "Stop recording on the device first, or the last few seconds are still buffered",
      "type": "shell",
      "command": "${workspaceFolder}/tools/monitor/.venv/bin/python",
      "args": ["tools/log_export/dump_log.py", "${input:logCsvPath}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Logs: Download to CSV (choose port…)",
      "detail": "Same, but for when auto-detect picks the wrong serial device",
      "type": "shell",
      "command": "${workspaceFolder}/tools/monitor/.venv/bin/python",
      "args": [
        "tools/log_export/dump_log.py",
        "--port",
        "${input:logSerialPort}",
        "${input:logCsvPath}"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Logs: List serial ports",
      "type": "shell",
      "command": "${workspaceFolder}/tools/monitor/.venv/bin/python",
      "args": ["tools/log_export/dump_log.py", "--list-ports"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Logs: Erase device log storage (destructive)",
      "detail": "LOGCLEAR — formats the log store and resets the capture count. Download first!",
      "type": "shell",
      "command": "${workspaceFolder}/tools/monitor/.venv/bin/python",
      "args": ["tools/log_export/dump_log.py", "--clear"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Catalog: Regenerate from signals.json",
      "detail": "Run tools/gen_catalog.py after editing the signal catalog",
      "type": "shell",
      "command": "python3",
      "args": ["tools/gen_catalog.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "logCsvPath",
      "type": "promptString",
      "description": "Where to write the decoded CSV (relative to the repo root)",
      "default": "log_export_out.csv"
    },
    {
      "id": "logSerialPort",
      "type": "promptString",
      "description": "Serial port of the dashboard Teensy (not the CAN sniffer)",
      "default": "/dev/cu.usbmodem"
    },
    {
      "id": "serialPort",
      "type": "promptString",
      "description": "Serial port of the Teensy sniffer",
      "default": "/dev/tty.usbmodem"
    }
  ]
}
