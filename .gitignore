.pio
# Mac monitor tool's virtualenv + Python caches (tools/monitor)
tools/monitor/.venv
**/__pycache__
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
**/.DS_Store
# Simulator runtime storage — regenerated by any simulator run, and the log
# chunks grow to 256KB apiece once a session runs long enough. Each
# directory's README is kept; everything else in them is ignored.
sim_storage/*
!sim_storage/README.md
sim_sdcard/*
!sim_sdcard/README.md

# Default output path of the "Logs: Download to CSV…" VS Code task
# (.vscode/tasks.json). Any other name you type is yours to manage.
/log_export_out.csv
